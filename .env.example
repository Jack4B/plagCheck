# ============================================================================
#  PlagCheck — konfiguracja (skopiuj do .env; na CT8 instalator robi to sam)
# ============================================================================

# Katalog na bazę SQLite, blokady i logi workera (poza katalogiem publicznym!)
DATA_DIR=./data

# Baza danych. Domyślnie SQLite w DATA_DIR. MySQL na CT8:
#   devil mysql db add plagcheck        (utworzy bazę m1234_plagcheck)
#   DATABASE_URL=mysql+pymysql://m1234_plagcheck:HASLO@mysql1.ct8.pl/m1234_plagcheck?charset=utf8mb4
# DATABASE_URL=

# Klucz dostępu do aplikacji (pusty = dostęp bez klucza). Zalecany na publicznym hostingu,
# bo każde sprawdzenie zużywa limit zapytań API wyszukiwarki.
ACCESS_KEY=

# --- Wyszukiwanie w sieci ---------------------------------------------------
# Źródła przeszukiwane RÓWNOLEGLE:
#   * wyszukiwarka internetowa z kluczem API (auto = pierwsza skonfigurowana: brave → serper → serpapi),
#   * Wikipedia (bez klucza), * OpenAlex — publikacje naukowe (bez klucza).
# SEARCH_PROVIDER: auto | brave | serper | serpapi | wikipedia (tylko Wikipedia) | none (bez sieci)
SEARCH_PROVIDER=auto
SEARCH_WIKIPEDIA=true
SEARCH_OPENALEX=true
# OpenAlex zaleca podanie adresu e-mail (szybsza "polite pool") — opcjonalne
# OPENALEX_MAILTO=
BRAVE_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARCH_LANG=pl
# Maks. liczba zapytań na dokument i stron pobieranych do porównania
MAX_WEB_QUERIES=25
MAX_PAGES_FETCHED=12
SEARCH_CACHE_HOURS=168
HTTP_TIMEOUT=10
# Wikipedia prosi o identyfikowalny User-Agent (np. z adresem Twojej instancji)
# HTTP_USER_AGENT=PlagCheck/1.0 (https://twojadomena.ct8.pl)

# --- Analiza ------------------------------------------------------------------
PHRASE_MIN_WORDS=10
PHRASE_MAX_WORDS=15
SHINGLE_SIZE=5
# Próg podobieństwa TF-IDF dla parafraz (0–1; wyżej = mniej fałszywych trafień)
PARAPHRASE_THRESHOLD=0.6
MAX_UPLOAD_MB=15
MAX_TEXT_CHARS=400000
# Opcjonalnie: dokładniejsza lematyzacja (pip install simplemma; ~+60 MB dysku)
# LEMMATIZER=simplemma

# --- Baza lokalna -------------------------------------------------------------
# Do tylu słów w bazie porównujemy z każdym dokumentem (wykrywa też parafrazy);
# powyżej — tylko z kandydatami z indeksu odcisków (winnowing), szybko przy dużych bazach
LOCAL_FULLSCAN_WORDS=300000
LOCAL_MAX_CANDIDATES=25

# --- Profil "full" (tylko Docker/VPS, NIE CT8) ----------------------------------
# Model embeddingów do parafraz synonimicznych; w obrazie Dockera ustawiony domyślnie.
# Pusta wartość wyłącza silnik semantyczny.
# SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# SEMANTIC_THRESHOLD=0.8

# --- Prywatność / zadania ------------------------------------------------------
# Raporty są usuwane po tylu godzinach; tekst dokumentu kasowany zaraz po analizie
REPORT_TTL_HOURS=72
# thread = analiza w wątku procesu WWW (+ cron jako zabezpieczenie) | cron = tylko cron
WORKER_MODE=thread
# Równoległe analizy (CT8: 2; Oracle A1 z ≥ 8 GB RAM: 4 — ustawia setup.sh)
MAX_CONCURRENT_JOBS=2

# --- Docker / Oracle (używane przez docker-compose.yml, ustawia setup.sh) --------
# Domena dla Caddy (HTTPS z Let's Encrypt), np. plagiat.mojadomena.pl albo 1-2-3-4.sslip.io
# DOMAIN=
# PLAGCHECK_PROFILE=full
# PLAGCHECK_MEM_LIMIT=4g
JOB_STALE_MINUTES=15
